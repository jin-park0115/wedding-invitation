rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    // one entry per visitor, keyed by their anonymous uid
    match /guestbook/{uid} {
      allow read: if true;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'msg', 'count', 'side', 'attend', 'at'])
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 20
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 300
        && request.resource.data.count is int
        && request.resource.data.count >= 1 && request.resource.data.count <= 10
        && request.resource.data.side in ['g', 'b']
        && request.resource.data.attend in ['yes', 'no']
        && request.resource.data.at is number;
    }

    // last heart burst; everyone listens for changes
    match /live/cheer {
      allow read: if true;
      allow create, update: if signedIn()
        && request.resource.data.keys().hasOnly(['at', 'by'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.at is number;
    }

    // "N명이 보고 있어요" heartbeats
    match /presence/{uid} {
      allow read: if true;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['at'])
        && request.resource.data.at is number;
    }
  }
}
